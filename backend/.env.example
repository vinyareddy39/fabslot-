# Copy these as real environment variables on your deployment platform
# (Railway/Render dashboard -> Variables). Do not commit a filled-in .env.

SPRING_DATASOURCE_URL=jdbc:mysql://<db-host>:<db-port>/<db-name>
SPRING_DATASOURCE_USERNAME=<db-user>
SPRING_DATASOURCE_PASSWORD=<db-password>
FABSLOT_JWT_SECRET=<a-long-random-string-at-least-32-chars>
FABSLOT_CORS_ORIGINS=https://<your-frontend-domain>
PORT=8080
